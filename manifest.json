{
  "manifest_version": 3,
  "name": "EZTranscript",
  "version": "1.0.0",
  "description": "Copy a YouTube video's full transcript to the clipboard in one click.",
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg",
      "48": "icons/icon-48.svg",
      "128": "icons/icon-128.svg"
    },
    "default_title": "EZTranscript — Copy YouTube transcript",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/watch*",
        "*://*.youtube.com/shorts/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["clipboardWrite", "tabs", "scripting"],
  "host_permissions": ["*://*.youtube.com/*"]
}
